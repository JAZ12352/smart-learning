    "exercises": [
      {
        "question": "在长度为n的顺序表中插入一个元素的时间复杂度是？",
        "options": [
          "O(1)",
          "O(logn)",
          "O(n)",
          "O(n²)"
        ],
        "answer": "C"
      },
      {
        "question": "栈和队列的共同特点是？",
        "options": [
          "都是先进先出",
          "都是先进后出",
          "只允许在端点处插入和删除元素",
          "没有共同点"
        ],
        "answer": "C"
      },
      {
        "question": "在一棵深度为5的完全二叉树中最多有多少个结点？",
        "options": [
          "15",
          "31",
          "32",
          "63"
        ],
        "answer": "B"
      },
      {
        "question": "下列排序算法中，最坏情况下时间复杂度最低的是？",
        "options": [
          "冒泡排序",
          "快速排序",
          "归并排序",
          "插入排序"
        ],
        "answer": "C"
      },
      {
        "question": "哈希表解决冲突的方法不包括？",
        "options": [
          "链地址法",
          "开放地址法",
          "再哈希法",
          "二分查找法"
        ],
        "answer": "D"
      }
    ],
