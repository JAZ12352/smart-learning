# ===========================================
# 智能教师管理系统 — 环境变量配置样例
# 用法：复制本文件为 .env，填入真实值；.env 已被 .gitignore 忽略，不会入库
# ===========================================

# ---------- MySQL 数据库 ----------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=xzs
MYSQL_PORT=3306

# ---------- 后端服务 ----------
BACKEND_PORT=8001
SPRING_PROFILES_ACTIVE=dev

# ---------- 管理端前端 ----------
ADMIN_PORT=8006

# ---------- 学生端前端 ----------
STUDENT_PORT=8010

# ---------- 大模型（DeepSeek）----------
# 申请地址 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.7

# ---------- 视频生成（Agnes）----------
# 仅「智能体生成工作台」的视频产出需要，留空则该功能不可用
AGNES_API_KEY=

# ---------- 七牛云对象存储 ----------
# 用于课件/图片上传，留空则上传相关接口不可用
QN_ACCESS_KEY=
QN_SECRET_KEY=
QN_BUCKET=mindskip
QN_URL=http://xzs.file.mindskip.net

# ---------- 多智能体服务（FastAPI）----------
PYTHON_SERVICE_URL=http://localhost:8100
