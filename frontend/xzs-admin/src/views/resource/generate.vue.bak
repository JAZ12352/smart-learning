<script>
import api from '@/api/resourceGeneration'

// ══════ 内置教学动画模板库 ══════
const ANIM_TEMPLATES = {
  // 知识点卡片轮播动画
  'knowledge-slideshow': (title, bulletPoints) => `<!DOCTYPE html>
<html><head><meta charset="UTF-8"><style>
*{margin:0;padding:0;box-sizing:border-box}body{display:flex;align-items:center;justify-content:center;height:100vh;background:#0f172a;overflow:hidden;font-family:"Microsoft YaHei",sans-serif}
.slide{position:absolute;width:80%;max-width:700px;text-align:center;opacity:0;transform:translateY(40px);transition:all 0.6s cubic-bezier(.4,0,.2,1)}
.slide.active{opacity:1;transform:translateY(0)}
.slide h2{font-size:32px;color:#f8fafc;margin-bottom:24px}
.slide .bullets{list-style:none;padding:0}
.slide .bullets li{padding:14px 20px;margin:10px 0;background:rgba(99,102,241,0.1);border-radius:12px;color:#cbd5e1;font-size:18px;border-left:3px solid #6366f1;text-align:left;animation:fadeIn 0.5s ease both}
@keyframes fadeIn{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:translateX(0)}}
.slide .bullets li:nth-child(1){animation-delay:0.1s}.slide .bullets li:nth-child(2){animation-delay:0.2s}.slide .bullets li:nth-child(3){animation-delay:0.3s}.slide .bullets li:nth-child(4){animation-delay:0.4s}.slide .bullets li:nth-child(5){animation-delay:0.5s}
.title-pg{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh}
.title-pg .icon{font-size:64px;margin-bottom:20px}
.title-pg h1{font-size:42px;color:#f8fafc;margin-bottom:12px}
.title-pg p{font-size:18px;color:#94a3b8}
.nav-dots{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);display:flex;gap:10px}
.nav-dots span{width:10px;height:10px;border-radius:50%;background:#475569;cursor:pointer;transition:all 0.3s}
.nav-dots span.active{background:#6366f1;width:28px;border-radius:5px}
</style></head><body>
<div id="app">${title ? \`<div class="title-pg slide active" data-idx="0"><div class="icon">📚</div><h1>${title}</h1><p>教学动画演示</p></div>\` : ''}${bulletPoints.map((b,i)=>{\`<div class="slide" data-idx="${i+1}"><h2>${b.title}</h2><ul class="bullets">${(b.items||[]).map(x=>\`<li>${x}</li>\`).join('')}</ul></div>\`}).join('')}</div>
<div class="nav-dots">${Array(bulletPoints.length+1).fill(0).map((_,i)=>{\`<span class="\${i===0?'active':''}" data-idx="${i}"></span>\`}).join('')}</div>
<script>
var slides=document.querySelectorAll('.slide'),dots=document.querySelectorAll('.nav-dots span'),current=0;
function show(i){slides.forEach(s=>s.classList.remove('active'));dots.forEach(d=>d.classList.remove('active'));slides[i]?.classList.add('active');dots[i]?.classList.add('active');current=i}
setInterval(()=>{show((current+1) % (${bulletPoints.length+1}))},4000);
dots.forEach(d=>{d.addEventListener('click',()=>show(parseInt(d.dataset.idx)))});
<\/script></body></html>`,

  // 概念讲解动画
  'concept-explainer': (title, content) => `<!DOCTYPE html>
<html><head><meta charset="UTF-8"><style>
*{margin:0;padding:0;box-sizing:border-box}body{display:flex;align-items:center;justify-content:center;height:100vh;background:linear-gradient(135deg,#0f172a,#1e1b4b);overflow:hidden;font-family:"Microsoft YaHei",sans-serif;color:#f8fafc}
.main{text-align:center;max-width:800px;padding:40px}
h1{font-size:40px;margin-bottom:16px;background:linear-gradient(135deg,#818cf8,#c084fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:titleIn 1s ease}
@keyframes titleIn{from{opacity:0;letter-spacing:20px}to{opacity:1;letter-spacing:2px}}
.divider{width:80px;height:3px;background:linear-gradient(90deg,#6366f1,transparent);margin:20px auto;animation:expand 1.2s ease}
@keyframes expand{from{width:0}to{width:80px}}
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:32px}
.card{padding:24px;background:rgba(30,27,75,0.6);border:1px solid rgba(99,102,241,0.2);border-radius:16px;text-align:left;animation:cardUp 0.6s ease both}
.card:nth-child(1){animation-delay:0.2s}.card:nth-child(2){animation-delay:0.4s}.card:nth-child(3){animation-delay:0.6s}.card:nth-child(4){animation-delay:0.8s}
@keyframes cardUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.card .num{font-size:28px;font-weight:800;color:#6366f1;margin-bottom:8px}
.card h3{font-size:18px;margin-bottom:6px;color:#e2e8f0}
.card p{font-size:14px;color:#94a3b8;line-height:1.6}
</style></head><body>
<div class="main">
<h1>${title}</h1>
<div class="divider"></div>
<div class="cards">${(content||[]).map((c,i)=>{\`<div class="card"><div class="num">0${i+1}</div><h3>${c.title}</h3><p>${c.desc}</p></div>\`}).join('')}</div>
</div>
</body></html>`,

  // 时间线演示动画
  'timeline-demo': (title, steps) => `<!DOCTYPE html>
<html><head><meta charset="UTF-8"><style>
*{margin:0;padding:0;box-sizing:border-box}body{display:flex;align-items:center;justify-content:center;min-height:100vh;background:#0f172a;font-family:"Microsoft YaHei",sans-serif;color:#f8fafc;padding:40px}
.container{max-width:700px;width:100%}
h1{text-align:center;font-size:32px;margin-bottom:48px;color:#e2e8f0}
.timeline{position:relative;padding-left:40px}
.timeline::before{content:'';position:absolute;left:18px;top:0;bottom:0;width:3px;background:linear-gradient(180deg,#6366f1,#a78bfa,#c084fc)}
.step{position:relative;margin-bottom:40px;padding:20px 24px;background:rgba(30,27,75,0.6);border:1px solid rgba(99,102,241,0.15);border-radius:14px;animation:slideIn 0.6s ease both}
.step:nth-child(1){animation-delay:0.2s}.step:nth-child(2){animation-delay:0.5s}.step:nth-child(3){animation-delay:0.8s}.step:nth-child(4){animation-delay:1.1s}.step:nth-child(5){animation-delay:1.4s}
@keyframes slideIn{from{opacity:0;transform:translateX(-30px)}to{opacity:1;transform:translateX(0)}}
.step::before{content:'';position:absolute;left:-32px;top:24px;width:14px;height:14px;border-radius:50%;background:#6366f1;border:3px solid #a78bfa;box-shadow:0 0 12px rgba(99,102,241,0.4)}
.step h3{font-size:18px;color:#e2e8f0;margin-bottom:6px}
.step p{font-size:14px;color:#94a3b8;line-height:1.6}
</style></head><body>
<div class="container">
<h1>${title}</h1>
<div class="timeline">${(steps||[]).map(s=>{\`<div class="step"><h3>${s.title}</h3><p>${s.desc}</p></div>\`}).join('')}</div>
</div>
</body></html>`
}

export default {
  name: 'ResourceGen',
  data: () => ({
    sel: 'document', topic: '', busy: false, body: '', sc: null, evaling: false, his: [], hid: null,
    mmObj: null, mmS: 1,
    vTl: null, scenes: [], codeSrc: '',
    animHtml: '', // 视频动画渲染的HTML内容
    types: [
      { key: 'document', label: '课程文档', icon: 'el-icon-document', desc: '结构化 Markdown', agent: 'Doc Agent', strategy: '生成完整教学文档' },
      { key: 'mind_map', label: '思维导图', icon: 'el-icon-share', desc: '交互式知识图谱', agent: 'MindMap Agent', strategy: 'JSON树→markmap导图' },
      { key: 'exercise', label: '练习题目', icon: 'el-icon-edit-outline', desc: '多题型+解析', agent: 'Quiz Agent', strategy: '选择题/填空/简答' },
      { key: 'extended_reading', label: '拓展阅读', icon: 'el-icon-reading', desc: '前沿延伸材料', agent: 'Reading Agent', strategy: '深度阅读+案例' },
      { key: 'video', label: '视频动画', icon: 'el-icon-video-camera', desc: 'HTML5动画播放', agent: 'Animation Agent', strategy: 'SVG+GSAP交互动画' },
      { key: 'code_example', label: '代码案例', icon: 'el-icon-cpu', desc: '可运行代码', agent: 'Code Agent', strategy: '沙箱可执行代码' }
    ]
  }),
  computed: {
    cur () { return this.types.find(t => t.key === this.sel) || this.types[0] },
    md () {
      if (!this.body) return ''
      let h = this.body.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      h = h.replace(/```(\w*)\n([\s\S]*?)```/g, (_, l, c) => '<pre class="cb"><code>' + c.replace(/</g, '&lt;') + '</code></pre>')
      h = h.replace(/^### (.+)/gm, '<h3>$1</h3>').replace(/^## (.+)/gm, '<h2>$1</h2>').replace(/^# (.+)/gm, '<h1>$1</h1>')
      h = h.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/`([^`]+)`/g, '<code class="ic">$1</code>')
      h = h.replace(/^[-*] (.+)/gm, '<li>$1</li>').replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
      h = h.replace(/\n{2,}/g, '</p><p>').replace(/\n/g, '<br>')
      return '<p>' + h + '</p>'
    }
  },
  mounted () { this.lh() },
  beforeDestroy () { if (this.mmObj) this.mmObj = null },
  methods: {
    async lh () { try { let r = await api.list({ userId: 0 }); if (r?.code === 1) this.his = Array.isArray(r.response) ? r.response : [] } catch (e) {} this.hid = null },

    async go () {
      if (!this.topic.trim()) { this.$message.warning('请输入学习主题'); return }
      if (this.busy) return
      this.busy = true; this.body = ''; this.sc = null; this.hid = null; this.animHtml = ''
      if (this.mmObj) { try { this.mmObj.destroy() } catch (e) {} this.mmObj = null }
      try {
        await api.generate({ userId: 0, resourceType: this.sel, topic: this.topic.trim() }, (c, f) => { this.body = f; this.ps(c) })
        this.$message.success('生成完成')
        this.$nextTick(() => {
          if (this.sel === 'mind_map') this.renderMM()
          if (this.sel === 'video') this.renderAnimFromContent()
        })
        await this.lh()
      } catch (e) { console.error(e); this.$message.error('生成失败') } finally { this.busy = false }
    },

    // ═══════════ MARKMAP ═══════════
    renderMM () {
      var c = this.$refs.mmSvg; if (!c || !this.body) return; c.innerHTML = ''
      var md = this.toMM(this.body)
      try {
        var { Markmap, Transformer } = window.markmap || {}
        if (!Markmap) { c.innerHTML = '<p style="padding:20px;color:#8c8470">markmap 库未加载，请检查网络</p>'; return }
        var t = new Transformer(); var { root } = t.transform(md)
        var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); svg.style.width = '100%'; svg.style.height = '520px'
        c.appendChild(svg)
        this.mmObj = Markmap.create(svg, { autoFit: true, colorFreezeLevel: 2, duration: 500, maxWidth: 300, paddingX: 16 }, root)
      } catch (e) { console.error(e); c.innerHTML = '<p style="padding:20px;color:#b7473b">markmap 渲染失败: ' + e.message + '</p>' }
    },
    toMM (content) {
      content = (content || '').trim()
      try { var o = JSON.parse(content); return this.j2m(o) } catch (e) {}
      var lines = content.split('\n'); var out = '# ' + this.topic + '\n'
      for (var i = 0; i < lines.length; i++) {
        var l = lines[i].trim(); if (!l) continue
        var m = l.match(/^(#{1,5})\s+(.+)/)
        if (m) { out += '  '.repeat(m[1].length - 1) + '- ' + m[2].replace(/\*\*/g, '') + '\n' } else if (l.startsWith('- ') || l.startsWith('* ')) { out += '  - ' + l.substring(2).trim() + '\n' }
      }
      return out || '# ' + this.topic + '\n- ' + content.substring(0, 80)
    },
    j2m (n, d) { d = d || 0; if (!n) return ''; var ind = '  '.repeat(d); var t = (n.title || n.name || n.text || n.label || '节点').replace(/[*#]/g, ''); var r = ind + '- ' + t + '\n'; var ch = n.children || n.nodes || n.items || []; if (Array.isArray(ch)) for (var i = 0; i < ch.length; i++) r += this.j2m(ch[i], d + 1); return r },
    mmZoom (d) { this.mmS = Math.max(0.3, Math.min(3, this.mmS + d)); var s = this.$refs.mmSvg?.querySelector('svg'); if (s) { s.style.transform = 'scale(' + this.mmS + ')'; s.style.transformOrigin = 'top left' } },
    mmFit () { this.mmS = 1; var s = this.$refs.mmSvg?.querySelector('svg'); if (s) s.style.transform = 'scale(1)' },

    // ═══════════ 视频动画：内置模板渲染 ═══════════
    renderAnimFromContent () {
      var scenes = this.parseContentToScenes(this.body)
      // 选择模板类型
      var templateType = scenes.length > 3 ? 'knowledge-slideshow' : 'concept-explainer'
      this.animHtml = ANIM_TEMPLATES[templateType](this.topic, scenes)
      // 渲染到 canvas 区域
      var cv = this.$refs.vCanvas
      if (cv) {
        var ctx = cv.getContext('2d'); ctx.clearRect(0, 0, 800, 500)
        ctx.fillStyle = '#0f172a'; ctx.fillRect(0, 0, 800, 500)
        ctx.fillStyle = '#f8fafc'; ctx.font = 'bold 20px "Microsoft YaHei",sans-serif'; ctx.textAlign = 'center'
        ctx.fillText('教学动画已生成(HTML格式)', 400, 220)
        ctx.fillStyle = '#94a3b8'; ctx.font = '14px "Microsoft YaHei",sans-serif'
        ctx.fillText('包含 ' + scenes.length + ' 个场景 · 自动轮播', 400, 260)
      }
      // 同时在 iframe 中渲染完整动画
      this.$nextTick(() => this.renderAnimIframe())
    },

    renderAnimIframe () {
      var container = this.$refs.animIframe
      if (!container || !this.animHtml) return
      container.innerHTML = ''
      var ifr = document.createElement('iframe')
      ifr.style.width = '100%'; ifr.style.height = '500px'; ifr.style.border = 'none'; ifr.style.borderRadius = '8px'
      ifr.sandbox = 'allow-scripts allow-same-origin'
      container.appendChild(ifr)
      var doc = ifr.contentDocument || ifr.contentWindow.document
      doc.open(); doc.write(this.animHtml); doc.close()
    },

    parseContentToScenes (content) {
      content = (content || '').trim()
      var scenes = []
      var parts = content.split(/\n(?:###|##)\s+/)
      if (parts.length <= 1) parts = content.split(/\n\n+/)
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i].trim(); if (!p || p.length < 5) continue
        var lines = p.split('\n')
        var title = lines[0].replace(/^#+\s*/, '').substring(0, 40)
        var items = []
        for (var j = 1; j < Math.min(lines.length, 6); j++) {
          var l = lines[j].replace(/^[-*]\s*/, '').trim()
          if (l && l.length > 3) items.push(l.substring(0, 50))
        }
        if (!items.length) items = [title]
        scenes.push({ title: title, items: items })
      }
      return scenes.length > 1 ? scenes : [{ title: '核心概念', items: [content.substring(0, 80)] }]
    },

    ps (c) { if (this.sc) return; var m = c.match(/质量[评分:：]\s*(\d+)/); if (m) this.sc = parseInt(m[1]) },
    async viewRec (r) {
      this.hid = r.id
      try { var d = await api.getDetail(r.id); if (d?.code === 1 && d.response) { this.body = d.response.content || ''; this.sc = d.response.qualityScore || null; this.sel = r.resourceType || this.sel; this.topic = r.title || this.topic; this.$nextTick(() => { if (this.sel === 'mind_map') this.renderMM(); if (this.sel === 'video') this.renderAnimFromContent() }) } } catch (e) {}
    },
    gi (t) { var f = this.types.find(x => x.key === t); return f ? f.icon : 'el-icon-document' },
    gl (t) { var f = this.types.find(x => x.key === t); return f ? f.label : '资源' },
    async doEval () { if (!this.hid || this.evaling) return; this.evaling = true; this.sc = null; try { await api.evaluate(this.hid, c => this.ps(c)); this.$message.success('评估完成') } catch (e) { this.$message.error('失败') } finally { this.evaling = false } },

    // 兼容旧方法
    startVid () { this.renderAnimFromContent() },
    replayVid () { this.renderAnimFromContent() },
    pauseVid () { },
    cleanVid () { }
  }
}
</script>
